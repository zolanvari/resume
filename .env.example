# Copy this file to .env and fill in real values. Never commit .env.
# chmod 600 .env after editing.

# AI provider
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash
AI_ENABLED=true

# Cloudflare Turnstile (server-side Siteverify secret)
TURNSTILE_SECRET_KEY=

# Rate limits (per IP)
RATE_LIMIT_POLISH_PER_IP_PER_HOUR=10
RATE_LIMIT_RENDER_PER_IP_PER_HOUR=60

# Body size limits
MAX_RESUME_CHARS=25000
MAX_PDF_MB=5

# Typst binary (inside the container)
TYPST_BIN=/usr/local/bin/typst
