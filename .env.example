# Copy this file to .env and fill in real values. Never commit .env.
# chmod 600 .env after editing.

# AI provider
GEMINI_API_KEY=
# Primary model; falls back to MODEL_FALLBACK when a call exceeds
# AI_TIMEOUT_SECONDS. Two attempts must fit nginx's 60s /api timeout.
MODEL_NAME=gemini-3.5-flash
MODEL_FALLBACK=gemini-2.5-flash
AI_TIMEOUT_SECONDS=25
AI_ENABLED=true

# Cloudflare Turnstile (server-side Siteverify secret)
TURNSTILE_SECRET_KEY=

# Rate limits (per IP)
RATE_LIMIT_POLISH_PER_IP_PER_HOUR=10
RATE_LIMIT_RENDER_PER_IP_PER_HOUR=60

# Body size limits
MAX_RESUME_CHARS=25000
MAX_PDF_MB=5

# Typst binary (inside the container)
TYPST_BIN=/usr/local/bin/typst

# Consent store (encrypted SQLite for opt-in name/email/headline).
# STORE_DB_PATH lives on the cv_data Docker volume.
# Generate STORE_ENCRYPTION_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave the key empty to disable the store entirely (nothing is persisted).
STORE_DB_PATH=/data/cv.db
STORE_ENCRYPTION_KEY=

# Notification hook (Telegram). Read by the out-of-tree hook module.
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_RENDER_THROTTLE_SECONDS=3600
